{
  "name": "screenpal",
  "version": "2.1.0",
  "description": "✨ Beautiful secondary screen companion — widgets, fish tank, music player, live wallpaper",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaitopenguin/screenpal.git"
  },
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . multiscreen-tool --platform=win32 --arch=x64 --out=dist --overwrite --prune=true"

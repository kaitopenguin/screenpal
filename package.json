    "desktop-widgets",
    "electron",
    "aquarium",
    "wallpaper-engine"
  ],
  "author": "kaitopenguin",
  "license": "MIT",
  "dependencies": {
    "systeminformation": "^5.25.11"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-packager": "^17.1.2"
  }
}
